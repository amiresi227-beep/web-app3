{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6cc451d6-c589-4c00-bbb5-1b974591584e","database_name": "web-app3" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b28733b61a13414fb578d6cdacbcc2f2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
